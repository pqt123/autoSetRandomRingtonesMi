{
  "name": "autoringtone-mi",
  "main": "expo-router/entry",
  "version": "1.0.4",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "r": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ok": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "b": "cd android && .\\gradlew assembleRelease -PreactNativeArchitectures=arm64-v8a && cd .. && node ./scripts/copy-release-apk.js",
    "build:android": "cd android && .\\gradlew assembleRelease -PreactNativeArchitectures=arm64-v8a && cd .. && node ./scripts/copy-release-apk.js",
    "build:all-arch": "cd android && .\\gradlew assembleRelease -PreactNativeArchitectures=armeabi-v7a,arm64-v8a && cd .. && node ./scripts/copy-release-apk.js",
    "updateVersion": "node ./scripts/update-version.js",
    "upd": "node ./scripts/update-version.js",
    "lint": "expo lint",
    "android:clean": "cd android && ./gradlew clean && cd .. && npm cache clean --force",
    "s": "cd android && ./gradlew --stop",
    "c": "cd android && ./gradlew --stop && ./gradlew clean && cd .. && npm cache clean --force"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "expo": "~57.0.18",
    "expo-background-task": "~57.0.14",
    "expo-constants": "~57.0.16",
    "expo-document-picker": "~57.0.1",
    "expo-font": "~57.0.2",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.3",
    "expo-intent-launcher": "~57.0.1",
    "expo-linking": "~57.0.8",
    "expo-media-library": "~57.0.4",
    "expo-ringtone": "file:./modules/expo-ringtone",
    "expo-router": "~57.0.17",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.3",
    "expo-task-manager": "~57.0.14",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-version": "^4.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "private": true,
  "workspaces": [
    "modules/*"
  ]
}
